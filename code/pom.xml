<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ct</groupId>
    <artifactId>ct-platform</artifactId>
    <version>4.2.0</version>
    <packaging>pom</packaging>
    <name>CT Platform</name>

    <modules>
        <module>ct-main</module>
        <module>ct-module-rules</module>
        <module>ct-module-theme</module>
        <module>ct-module-console</module>
        <module>ct-module-settings</module>
        <module>ct-module-installer</module>
        <module>ct-module-versions</module>
        <module>ct-module-launcher</module>
        <module>ct-module-account-offline</module>
        <module>ct-module-account-microsoft</module>
        <module>ct-module-ctloader</module>
        <module>ct-module-cli</module>
        <module>ct-module-modman</module>
        <module>ct-module-about</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <gson.version>2.13.1</gson.version>
        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.ct</groupId>
                <artifactId>ct-main</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ct</groupId>
                <artifactId>ct-module-rules</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ct</groupId>
                <artifactId>ct-module-theme</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ct</groupId>
                <artifactId>ct-module-console</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ct</groupId>
                <artifactId>ct-module-settings</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ct</groupId>
                <artifactId>ct-module-installer</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ct</groupId>
                <artifactId>ct-module-versions</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ct</groupId>
                <artifactId>ct-module-launcher</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ct</groupId>
                <artifactId>ct-module-account-offline</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ct</groupId>
                <artifactId>ct-module-account-microsoft</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ct</groupId>
                <artifactId>ct-module-ctloader</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ct</groupId>
                <artifactId>ct-module-cli</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ct</groupId>
                <artifactId>ct-module-modman</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ct</groupId>
                <artifactId>ct-module-about</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.code.gson</groupId>
                <artifactId>gson</artifactId>
                <version>${gson.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                    <configuration>
                        <excludes>
                            <exclude>**/._*</exclude>
                        </excludes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.6.0</version>
                    <executions>
                        <execution>
                            <id>runnable-module</id>
                            <phase>package</phase>
                            <goals>
                                <goal>shade</goal>
                            </goals>
                            <configuration>
                                <shadedArtifactAttached>false</shadedArtifactAttached>
                                <createDependencyReducedPom>false</createDependencyReducedPom>
                                <artifactSet>
                                    <includes>
                                        <include>com.ct:ct-main</include>
                                        <include>com.google.code.gson:gson</include>
                                    </includes>
                                </artifactSet>
                                <filters>
                                    <filter>
                                        <artifact>com.ct:ct-main</artifact>
                                        <includes>
                                            <include>com/ct/main/moduleinstall/**</include>
                                        </includes>
                                    </filter>
                                    <filter>
                                        <artifact>*:*</artifact>
                                        <excludes>
                                            <exclude>META-INF/*.SF</exclude>
                                            <exclude>META-INF/*.DSA</exclude>
                                            <exclude>META-INF/*.RSA</exclude>
                                        </excludes>
                                    </filter>
                                </filters>
                                <transformers>
                                    <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                        <mainClass>com.ct.main.moduleinstall.ModuleInstaller</mainClass>
                                    </transformer>
                                </transformers>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
